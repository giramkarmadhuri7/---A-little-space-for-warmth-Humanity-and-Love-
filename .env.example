# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Cryptographic secret used to sign Admin Passphrase verification sessions.
# Generate a strong random 32+ character string in production.
SESSION_SECRET="replace-with-strong-random-secret-in-production"

# SQL_* variables are automatically injected by Cloud SQL in production/preview.
# SQL_HOST=
# SQL_DB_NAME=
# SQL_USER=
# SQL_PASSWORD=
# SQL_ADMIN_USER=
# SQL_ADMIN_PASSWORD=
